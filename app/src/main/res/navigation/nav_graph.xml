<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/plantsFragment">

    <fragment
        android:id="@+id/plantsFragment"
        android:name="ca.gbc.comp3074.nicholas.plantpal.ui.plants.PlantsFragment"
        android:label="@string/nav_plants">
        <action
            android:id="@+id/action_plants_to_detail"
            app:destination="@id/plantDetailFragment" />
        <action
            android:id="@+id/action_plants_to_addEdit"
            app:destination="@id/addEditPlantFragment" />
    </fragment>

    <fragment
        android:id="@+id/plantDetailFragment"
        android:name="ca.gbc.comp3074.nicholas.plantpal.ui.detail.PlantDetailFragment"
        android:label="@string/title_plant_detail">
        <argument
            android:name="plantId"
            app:argType="long" />
        <action
            android:id="@+id/action_detail_to_addEdit"
            app:destination="@id/addEditPlantFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditPlantFragment"
        android:name="ca.gbc.comp3074.nicholas.plantpal.ui.edit.AddEditPlantFragment"
        android:label="@string/title_add_plant">
        <argument
            android:name="plantId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/weatherFragment"
        android:name="ca.gbc.comp3074.nicholas.plantpal.ui.weather.WeatherFragment"
        android:label="@string/title_weather_tips" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="ca.gbc.comp3074.nicholas.plantpal.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />
</navigation>
